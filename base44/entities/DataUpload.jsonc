{
  "name": "DataUpload",
  "type": "object",
  "properties": {
    "filename": {
      "type": "string"
    },
    "upload_type": {
      "type": "string",
      "enum": [
        "price_list",
        "calculator"
      ]
    },
    "records_count": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "error",
        "processing"
      ]
    },
    "error_message": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    }
  },
  "required": [
    "filename",
    "upload_type",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}