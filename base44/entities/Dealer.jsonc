      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "uid": {
      "type": "string"
    },
    "analytics_enabled": {
      "type": "boolean",
      "default": true
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
